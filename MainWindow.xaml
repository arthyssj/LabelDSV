<Window x:Class="EtiquetasDSV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Etiquetas DSV" Height="700" Width="1000" MinHeight="600" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Icon="/icon.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- HEADER -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" Padding="20,10">
            <TextBlock Text="Etiquetas DSV" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextMain}"/>
        </Border>

        <TabControl Grid.Row="1">

            <!-- ============================================================ -->
            <!-- TAB 1: IMPRIMIR INDIVIDUAL -->
            <!-- ============================================================ -->
            <TabItem Header="Imprimir individual">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Panel de captura -->
                    <Border Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource PanelStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Datos de la etiqueta" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                            <TextBlock Text="Part Number:" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtParte" TextChanged="Campo_Cambiado"/>

                            <TextBlock Text="Quantity:" Margin="0,10,0,3"/>
                            <TextBox x:Name="TxtCantidad" TextChanged="Campo_Cambiado"/>

                            <TextBlock Text="Reference:" Margin="0,10,0,3"/>
                            <TextBox x:Name="TxtReferencia" TextChanged="Campo_Cambiado"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <CheckBox x:Name="ChkReferenciaAuto" Content="Automatica" VerticalAlignment="Center"
                                          Checked="ChkReferenciaAuto_Checked" Unchecked="ChkReferenciaAuto_Unchecked"/>
                                <Button Content="Generar" Style="{StaticResource BotonNormal}"
                                        Padding="10,4" Margin="12,0,0,0" Click="BtnGenerarReferencia_Click"/>
                            </StackPanel>

                            <TextBlock Text="Tipo:" Margin="0,10,0,3"/>
                            <ComboBox x:Name="CmbTipo" SelectionChanged="Campo_Cambiado">
                                <ComboBoxItem Content="INBOND" IsSelected="True"/>
                                <ComboBoxItem Content="DOMESTIC"/>
                            </ComboBox>

                            <TextBlock Text="Notes:" Margin="0,10,0,3"/>
                            <TextBox x:Name="TxtNotas" Height="50" TextWrapping="Wrap"
                                     AcceptsReturn="True" TextChanged="Campo_Cambiado"/>

                            <TextBlock Text="Copias:" Margin="0,10,0,3"/>
                            <TextBox x:Name="TxtCopias" Text="4" Width="60" HorizontalAlignment="Left"/>

                            <TextBlock Text="Impresora:" Margin="0,10,0,3"/>
                            <ComboBox x:Name="CmbImpresora"/>

                            <Button Content="Actualizar lista de impresoras" Style="{StaticResource BotonNormal}"
                                    Margin="0,12,0,0" Click="BtnActualizarImpresoras_Click"/>

                            <Button Content="Vista previa" Style="{StaticResource BotonNormal}"
                                    Margin="0,14,0,0" Click="BtnVistaPrevia_Click"/>

                            <Button Content="Imprimir" Style="{StaticResource BotonImprimir}"
                                    Height="40" Margin="0,10,0,0" Click="BtnImprimirIndividual_Click"/>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Vista previa -->
                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" Text="Vista previa" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Border Background="#E8E8E8" BorderBrush="{StaticResource BorderCol}" BorderThickness="1"
                                CornerRadius="10" Effect="{StaticResource PanelShadow}">
                            <Viewbox Stretch="Uniform" Margin="10">
                                <Canvas x:Name="CanvasPreview" Width="650" Height="400" Background="White"/>
                            </Viewbox>
                        </Border>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============================================================ -->
            <!-- TAB 2: IMPRIMIR LOTE -->
            <!-- ============================================================ -->
            <TabItem Header="Imprimir lote">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,10"
                        Text="Pega filas desde Excel (Part Number, Quantity, Reference, Tipo, Notes) o agrega manualmente."/>

                    <DataGrid Grid.Row="1" x:Name="GridLote" AutoGenerateColumns="False"
                              CanUserAddRows="False" HeadersVisibility="Column" CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Part Number" Binding="{Binding Parte}" Width="160"/>
                            <DataGridTextColumn Header="Quantity" Binding="{Binding Cantidad}" Width="100"/>
                            <DataGridTextColumn Header="Reference" Binding="{Binding Referencia}" Width="160"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="110"/>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notas}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button Content="Agregar fila" Style="{StaticResource BotonNormal}"
                                Margin="0,0,8,0" Click="BtnAgregarFila_Click"/>
                        <Button Content="Duplicar fila" Style="{StaticResource BotonNormal}"
                                Margin="0,0,8,0" Click="BtnDuplicarFila_Click"/>
                        <Button Content="Pegar" Style="{StaticResource BotonNormal}"
                                Margin="0,0,8,0" Click="BtnPegar_Click"/>
                        <Button Content="Eliminar fila" Style="{StaticResource BotonNormal}"
                                Margin="0,0,8,0" Click="BtnEliminarFila_Click"/>
                        <Button Content="Limpiar todo" Style="{StaticResource BotonNormal}"
                                Margin="0,0,8,0" Click="BtnLimpiarTabla_Click"/>
                        <Button Content="Generar refs" Style="{StaticResource BotonNormal}"
                                Margin="0,0,8,0" Click="BtnGenerarReferenciasLote_Click"/>
                    </WrapPanel>

                    <Border Grid.Row="3" Margin="0,14,0,0" Style="{StaticResource PanelStyle}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Impresion del lote" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Copias por etiqueta:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtCopiasLote" Text="4" Width="50" Margin="0,0,24,0"/>

                                <TextBlock Text="Impresora:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbImpresoraLote" Width="220" Margin="0,0,24,0"/>

                                <Button x:Name="BtnImprimirLote" Content="Imprimir lote"
                                        Style="{StaticResource BotonImprimir}" Margin="0,0,8,0"
                                        Click="BtnImprimirLote_Click"/>

                                <Button x:Name="BtnCancelarLote" Content="Cancelar"
                                        Style="{StaticResource BotonCancelar}" Margin="0,0,8,0"
                                        IsEnabled="False" Click="BtnCancelarLote_Click"/>

                                <Button Content="Reiniciar conteo" Style="{StaticResource BotonNormal}"
                                        Click="BtnLimpiarConteo_Click"/>
                            </WrapPanel>

                            <TextBlock x:Name="TxtConteo" Margin="0,10,0,4" FontWeight="Bold"
                                       Text="Modelos en lote: 0   |   Total de etiquetas: 0"/>

                            <ProgressBar x:Name="BarraProgreso" Margin="0,4,0,4"/>

                            <TextBlock x:Name="TxtEstadoLote" Text="Listo." Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================================================ -->
            <!-- TAB 3: IMPRIMIR PALLET -->
            <!-- ============================================================ -->
            <TabItem Header="Pallet">
                <Border Margin="16" MaxWidth="360" HorizontalAlignment="Left" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Datos de la etiqueta de pallet" FontSize="15" FontWeight="Bold" Margin="0,0,0,14"/>

                        <TextBlock Text="Reference:" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtReferenciaPallet"/>

                        <TextBlock Text="Pallet:" Margin="0,10,0,3"/>
                        <TextBox x:Name="TxtPallet"/>

                        <TextBlock Text="Copias:" Margin="0,10,0,3"/>
                        <TextBox x:Name="TxtCopiasPallet" Text="4" Width="60" HorizontalAlignment="Left"/>

                        <TextBlock Text="Impresora:" Margin="0,10,0,3"/>
                        <ComboBox x:Name="CmbImpresoraPallet"/>

                        <Button Content="Actualizar lista de impresoras" Style="{StaticResource BotonNormal}"
                                Margin="0,12,0,0" Click="BtnActualizarImpresoras_Click"/>

                        <Button Content="Imprimir" Style="{StaticResource BotonImprimir}"
                                Height="40" Margin="0,10,0,0" Click="BtnImprimirPallet_Click"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- ============================================================ -->
            <!-- TAB 4: CONFIGURACION -->
            <!-- ============================================================ -->
            <TabItem Header="Configuracion">
                <Border Margin="16" MaxWidth="520" HorizontalAlignment="Left" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Datos fijos de la etiqueta" FontSize="15" FontWeight="Bold" Margin="0,0,0,16"/>

                        <TextBlock Text="Titulo (header):" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtTitulo"/>

                        <TextBlock Text="From - linea 1:" Margin="0,10,0,3"/>
                        <TextBox x:Name="TxtFrom1"/>

                        <TextBlock Text="From - linea 2:" Margin="0,10,0,3"/>
                        <TextBox x:Name="TxtFrom2"/>

                        <TextBlock Text="Formato de fecha (.NET):" Margin="0,10,0,3"/>
                        <TextBox x:Name="TxtFormatoFecha"/>

                        <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextMuted}" FontSize="11"
                            Text="Ejemplos: dd-MM-yyyy = 31-07-2026     yyyy-MM-dd = 2026-07-31"/>

                        <TextBlock Text="Contador de referencias automaticas:" Margin="0,16,0,3"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="La proxima sera RF...-" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtProximaReferencia" Width="60" Margin="6,0,0,0"/>
                            <Button Content="Reiniciar contador" Style="{StaticResource BotonNormal}"
                                    Padding="10,4" Margin="12,0,0,0" Click="BtnReiniciarContadorRef_Click"/>
                        </StackPanel>

                        <Button Content="Guardar configuracion" Style="{StaticResource BotonImprimir}"
                                Width="220" HorizontalAlignment="Left" Margin="0,20,0,0"
                                Click="BtnGuardarConfig_Click"/>
                    </StackPanel>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
