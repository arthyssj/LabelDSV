<Window x:Class="EtiquetasDSV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Etiquetas DSV" Height="720" Width="1080" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- HEADER -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" Padding="24,16">
            <TextBlock Text="Etiquetas DSV" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextMain}"/>
        </Border>

        <TabControl Grid.Row="1">

            <!-- ============================================================ -->
            <!-- TAB 1: IMPRIMIR INDIVIDUAL -->
            <!-- ============================================================ -->
            <TabItem Header="Imprimir individual">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Panel de captura -->
                    <Border Grid.Column="0" Margin="0,0,16,0" Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Datos de la etiqueta" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

                            <TextBlock Text="Part Number:" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtParte" TextChanged="Campo_Cambiado"/>

                            <TextBlock Text="Quantity:" Margin="0,14,0,4"/>
                            <TextBox x:Name="TxtCantidad" TextChanged="Campo_Cambiado"/>

                            <TextBlock Text="Reference:" Margin="0,14,0,4"/>
                            <TextBox x:Name="TxtReferencia" TextChanged="Campo_Cambiado"/>

                            <TextBlock Text="Tipo:" Margin="0,14,0,4"/>
                            <ComboBox x:Name="CmbTipo" SelectionChanged="Campo_Cambiado">
                                <ComboBoxItem Content="IN-BOND" IsSelected="True"/>
                                <ComboBoxItem Content="DOMESTIC"/>
                            </ComboBox>

                            <TextBlock Text="Notes:" Margin="0,14,0,4"/>
                            <TextBox x:Name="TxtNotas" Height="60" TextWrapping="Wrap"
                                     AcceptsReturn="True" TextChanged="Campo_Cambiado"/>

                            <TextBlock Text="Copias:" Margin="0,14,0,4"/>
                            <TextBox x:Name="TxtCopias" Text="4" Width="60" HorizontalAlignment="Left"/>

                            <TextBlock Text="Impresora:" Margin="0,14,0,4"/>
                            <ComboBox x:Name="CmbImpresora"/>

                            <Button Content="Actualizar lista de impresoras" Style="{StaticResource BotonNormal}"
                                    Margin="0,16,0,0" Click="BtnActualizarImpresoras_Click"/>

                            <Button Content="Vista previa" Style="{StaticResource BotonNormal}"
                                    Margin="0,20,0,0" Click="BtnVistaPrevia_Click"/>

                            <Button Content="IMPRIMIR" Style="{StaticResource BotonImprimir}"
                                    Height="44" Margin="0,14,0,0" Click="BtnImprimirIndividual_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Vista previa -->
                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" Text="Vista previa" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Border Background="#E8E8E8" BorderBrush="{StaticResource BorderCol}" BorderThickness="1"
                                CornerRadius="10" Effect="{StaticResource PanelShadow}">
                            <Viewbox Stretch="Uniform" Margin="12">
                                <Canvas x:Name="CanvasPreview" Width="650" Height="400" Background="White"/>
                            </Viewbox>
                        </Border>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============================================================ -->
            <!-- TAB 2: IMPRIMIR LOTE -->
            <!-- ============================================================ -->
            <TabItem Header="Imprimir lote">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,12"
                        Text="Pega filas desde Excel (Part Number, Quantity, Reference, Tipo, Notes) o agrega manualmente."/>

                    <DataGrid Grid.Row="1" x:Name="GridLote" AutoGenerateColumns="False"
                              CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Part Number" Binding="{Binding Parte}" Width="160"/>
                            <DataGridTextColumn Header="Quantity" Binding="{Binding Cantidad}" Width="100"/>
                            <DataGridTextColumn Header="Reference" Binding="{Binding Referencia}" Width="160"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="110"/>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notas}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Grid.Row="2" Margin="0,16,0,0">
                        <Button Content="Agregar fila vacia" Style="{StaticResource BotonNormal}"
                                Margin="0,0,8,0" Click="BtnAgregarFila_Click"/>
                        <Button Content="Pegar del portapapeles (Ctrl+V)" Style="{StaticResource BotonNormal}"
                                Margin="0,0,8,0" Click="BtnPegar_Click"/>
                        <Button Content="Eliminar fila seleccionada" Style="{StaticResource BotonNormal}"
                                Margin="0,0,8,0" Click="BtnEliminarFila_Click"/>
                        <Button Content="Limpiar todo" Style="{StaticResource BotonNormal}"
                                Margin="0,0,8,0" Click="BtnLimpiarTabla_Click"/>
                    </WrapPanel>

                    <Border Grid.Row="3" Margin="0,20,0,0" Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Impresion del lote" FontWeight="Bold" FontSize="14" Margin="0,0,0,14"/>

                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Copias por etiqueta:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtCopiasLote" Text="4" Width="50" Margin="0,0,24,0"/>

                                <TextBlock Text="Impresora:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbImpresoraLote" Width="220" Margin="0,0,24,0"/>

                                <Button x:Name="BtnImprimirLote" Content="IMPRIMIR LOTE"
                                        Style="{StaticResource BotonImprimir}" Padding="16,8" Margin="0,0,8,0"
                                        Click="BtnImprimirLote_Click"/>

                                <Button x:Name="BtnCancelarLote" Content="CANCELAR"
                                        Style="{StaticResource BotonCancelar}" Padding="16,8" Margin="0,0,8,0"
                                        IsEnabled="False" Click="BtnCancelarLote_Click"/>

                                <Button Content="Limpiar cola / reiniciar conteo" Style="{StaticResource BotonNormal}"
                                        Click="BtnLimpiarConteo_Click"/>
                            </WrapPanel>

                            <TextBlock x:Name="TxtConteo" Margin="0,14,0,4" FontWeight="Bold"
                                       Text="Modelos en lote: 0   |   Total de etiquetas: 0"/>

                            <ProgressBar x:Name="BarraProgreso" Margin="0,4,0,4"/>

                            <TextBlock x:Name="TxtEstadoLote" Text="Listo." Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================================================ -->
            <!-- TAB 3: CONFIGURACION -->
            <!-- ============================================================ -->
            <TabItem Header="Configuracion">
                <Border Margin="20" MaxWidth="540" HorizontalAlignment="Left" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Datos fijos de la etiqueta" FontSize="16" FontWeight="Bold" Margin="0,0,0,18"/>

                        <TextBlock Text="Titulo (header):" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtTitulo"/>

                        <TextBlock Text="From - linea 1:" Margin="0,14,0,4"/>
                        <TextBox x:Name="TxtFrom1"/>

                        <TextBlock Text="From - linea 2:" Margin="0,14,0,4"/>
                        <TextBox x:Name="TxtFrom2"/>

                        <TextBlock Text="Formato de fecha (.NET):" Margin="0,14,0,4"/>
                        <TextBox x:Name="TxtFormatoFecha"/>

                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextMuted}" FontSize="11"
                            Text="Ejemplos: dd-MM-yyyy = 31-07-2026     yyyy-MM-dd = 2026-07-31"/>

                        <Button Content="Guardar configuracion" Style="{StaticResource BotonImprimir}"
                                Width="220" HorizontalAlignment="Left" Margin="0,24,0,0"
                                Click="BtnGuardarConfig_Click"/>
                    </StackPanel>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
